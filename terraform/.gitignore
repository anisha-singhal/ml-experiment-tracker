.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# `terraform plan -out=tfplan` has no extension, so *.tfplan alone misses it.
# A saved plan embeds the account ID and every resource attribute.
tfplan
crash.log

# Real variable values, which may name accounts or CIDRs. The .example is committed.
terraform.tfvars
*.auto.tfvars

# Credentials must never be committed.
*.pem
*.key
credentials
